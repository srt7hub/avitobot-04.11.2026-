generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  status            TenantStatus @default(TRIAL)
  botName           String       @default("Менеджер")
  customPrompt      String?
  telegramBotToken  String       @default("")
  telegramChatId    String       @default("")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users       TenantUser[]
  properties  Property[]
  faqEntries  FaqEntry[]
  avitoConfig TenantAvitoConfig?
  dialogues   Dialogue[]
  unhandled   UnhandledQuestion[]
  botSessions BotSession[]
  bookings    Booking[]
  calendarSyncs  CalendarSync[]
  calendarBlocks CalendarBlock[]
  calendarFeeds  CalendarFeed[]
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAUSED
  CANCELLED
}

// ─── TenantUser ───────────────────────────────────────────────────────────────

model TenantUser {
  id              String        @id @default(cuid())
  tenantId        String
  email           String
  password        String
  role            TenantUserRole @default(CLIENT)
  name            String
  telegramContact String        @default("")
  createdAt       DateTime      @default(now())

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum TenantUserRole {
  CLIENT
  OPS
}

// ─── TenantAvitoConfig ────────────────────────────────────────────────────────

model TenantAvitoConfig {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  avitoClientId     String    @default("")
  avitoClientSecret String    @default("")
  avitoUserId       String    @default("")
  accessToken       String    @default("")
  refreshToken      String    @default("")
  tokenExpiresAt    DateTime?
  lastPolledAt      DateTime?
  pollingEnabled    Boolean   @default(true)
  // Предохранитель первого запуска: бот отвечает ТОЛЬКО на сообщения,
  // пришедшие после этого момента. Ставится один раз при первом поллинге
  // тенанта, чтобы не разослать ответы на накопившийся бэклог.
  pollingStartedAt  DateTime?
  // Offset для Telegram getUpdates: id последнего обработанного апдейта.
  // Хранится в БД, чтобы после рестарта бота не переиграть старые нажатия кнопок.
  tgUpdateOffset    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Property ─────────────────────────────────────────────────────────────────

model Property {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  address     String   @default("")
  description String   @default("")
  avitoItemId String   @default("")
  isActive    Boolean  @default(true)

  // Чувствительные данные — отдаются гостю только в разрешённой фазе
  // (оплатил + заехал), см. isSensitiveDataAllowed / guestPhase.
  doorCode             String @default("")
  intercomCode         String @default("")
  mapUrl               String @default("")
  wifiName             String @default("")
  wifiPassword         String @default("")
  checkInInstructions  String @default("")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  faqEntries  FaqEntry[]
  dialogues   Dialogue[]
  bookings    Booking[]
  calendarSyncs CalendarSync[]
  calendarFeed  CalendarFeed?

  @@index([tenantId])
  @@index([tenantId, avitoItemId])
}

// ─── Booking ──────────────────────────────────────────────────────────────────
// Бронь гостя. Заполняется синхронизацией из Avito STR booking API (отдельный
// этап). Нужна боту для вычисления фазы гостя (computeGuestPhase) и гейтинга
// чувствительных данных (код двери / wifi выдаются только оплатившему и заехавшему).

model Booking {
  id             String   @id @default(cuid())
  tenantId       String
  propertyId     String

  avitoBookingId String   @default("")   // ID брони из Avito STR API
  avitoChatId    String   @default("")   // привязка к чату мессенджера

  guestName      String   @default("")
  checkIn        DateTime
  checkOut       DateTime

  totalPrice     Float    @default(0)
  prepaidAmount  Float    @default(0)    // предоплата (safe_deposit) — >0 значит оплачено

  // accessUnlocked — признак, что доступ к квартире можно открывать (оплачено).
  // Выставляется синхронизацией; используется фазами как явный флаг оплаты.
  accessUnlocked Boolean  @default(false)

  // paymentMsgSent — сообщение «оплата получена» гостю уже отправлено.
  // Гарантирует ровно одну отправку при переходе prepaidAmount 0 → >0.
  paymentMsgSent Boolean  @default(false)

  status         String   @default("ПОДТВЕРЖДЕНО")
  source         String   @default("Авито")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  checkinDispatch CheckinDispatch?

  @@unique([tenantId, avitoBookingId])
  @@index([tenantId, avitoChatId])
  @@index([propertyId])
}

// ─── CheckinDispatch ─────────────────────────────────────────────────────────
// Одна запись на бронь: планирование, подтверждение менеджером и аудит отправки
// инструкции. Не допускает дублей при рестарте бота или повторном cron-цикле.
model CheckinDispatch {
  id                  String    @id @default(cuid())
  tenantId            String
  bookingId           String    @unique
  scheduledFor        DateTime
  approvalRequestedAt DateTime?
  deferredUntil       DateTime?
  sentAt              DateTime?
  sentBy              String    @default("")
  cancelledAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId, scheduledFor])
}

// ─── CalendarSync ─────────────────────────────────────────────────────────────
// Подключённый iCal-канал объекта: одна строка = один внешний календарь
// (Яндекс Путешествия, Авито, Циан…). Синхронизация занятости идёт только
// через iCal: цены протокол не передаёт, поэтому цены остаются ручными.
//
// Направления:
//   importUrl — .ics чужой площадки, откуда мы тянем чужие брони (pull);
//   экспорт — наш собственный .ics, отдаётся по CalendarFeed.token и
//   вставляется в экстранет площадки, чтобы она забирала наши даты (push).

model CalendarSync {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String

  // Площадка: ЯНДЕКС | АВИТО | ЦИАН | ДРУГОЕ. Строкой, а не enum — площадки
  // добавляются без миграции, ровно как source у Booking.
  platform   String   @default("ЯНДЕКС")
  importUrl  String   @default("")
  isActive   Boolean  @default(true)

  // Телеметрия последнего pull — показывается на вкладке «Календарь»,
  // чтобы клиент видел живой канал, а не молчаливо протухший.
  lastSyncAt      DateTime?
  lastSyncStatus  String    @default("")   // ОК | ОШИБКА | пусто (ещё не синкали)
  lastSyncError   String    @default("")
  lastEventCount  Int       @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  blocks     CalendarBlock[]

  @@unique([propertyId, platform])
  @@index([tenantId])
}

// ─── CalendarBlock ────────────────────────────────────────────────────────────
// Занятый интервал, пришедший из внешнего iCal (не наша бронь из Avito API —
// та живёт в Booking). Полностью пересоздаётся при каждом успешном pull:
// исчез VEVENT на той стороне → исчезла блокировка здесь → даты открылись.
// Это и даёт «отмена брони открывает даты обратно» без отдельной логики.

model CalendarBlock {
  id        String   @id @default(cuid())
  tenantId  String
  syncId    String

  uid       String   @default("")   // UID из VEVENT — для дедупликации внутри фида
  summary   String   @default("")
  start     DateTime                // включительно (день заезда)
  end       DateTime                // ИСКЛЮЧИТЕЛЬНО (день выезда свободен) — семантика DTEND в iCal

  createdAt DateTime @default(now())

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sync      CalendarSync @relation(fields: [syncId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([syncId])
  @@index([tenantId, start, end])
}

// ─── CalendarFeed ─────────────────────────────────────────────────────────────
// Наш исходящий .ics для объекта. Токен — секрет в URL: фид отдаётся без
// авторизации (площадка не умеет присылать заголовки), поэтому токен должен
// быть длинным случайным и меняться при компрометации (rotate).

model CalendarFeed {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String   @unique
  token      String   @unique

  // Площадка-получатель этой ссылки. Её собственные брони в фид не попадают,
  // иначе она увидит их как чужую занятость. Пусто = отдаём всё.
  forPlatform String  @default("")

  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── FaqEntry ─────────────────────────────────────────────────────────────────

model FaqEntry {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String?
  question   String
  answer     String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, propertyId])
}

// ─── UnhandledQuestion ────────────────────────────────────────────────────────

model UnhandledQuestion {
  id         String    @id @default(cuid())
  tenantId   String
  question   String
  chatId     String    @default("")
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isResolved])
}

// ─── Dialogue ─────────────────────────────────────────────────────────────────

model Dialogue {
  id            String    @id @default(cuid())
  tenantId      String
  propertyId    String?
  avitoChatId   String
  guestName     String    @default("")
  messageCount  Int       @default(0)
  lastMessageAt DateTime?
  pausedUntil   DateTime?
  // Полное отключение бота для этого чата клиентом (в отличие от pausedUntil —
  // временной авто-паузы на 30 мин). Пока true — бот не отвечает вообще.
  botDisabled   Boolean   @default(false)
  greetingSent  Boolean   @default(false)
  summary       String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@unique([tenantId, avitoChatId])
  @@index([tenantId])
}

// ─── Message ──────────────────────────────────────────────────────────────────

model Message {
  id          String      @id @default(cuid())
  dialogueId  String
  avitoMsgId  String      @unique
  role        MessageRole
  content     String
  processedAt DateTime    @default(now())

  dialogue    Dialogue    @relation(fields: [dialogueId], references: [id], onDelete: Cascade)

  @@index([dialogueId])
  @@index([avitoMsgId])
}

enum MessageRole {
  GUEST
  BOT
}

// ─── BotSession ───────────────────────────────────────────────────────────────

model BotSession {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  isRunning      Boolean   @default(false)
  lastPollAt     DateTime?
  errorCount     Int       @default(0)
  lastError      String    @default("")
  messagesDay    Int       @default(0)
  messagesWeek   Int       @default(0)
  messagesMonth  Int       @default(0)
  autoReplyRate  Float     @default(0)
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
